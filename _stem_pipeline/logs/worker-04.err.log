# -*- coding: utf-8 -*-
import json, os, re, sys

SITE = r'D:\\ccho-site-public'
OUT_STEMS = os.path.join(SITE, '_stem_pipeline', 'out', 'stems')
OUT_LATEX = os.path.join(SITE, '_stem_pipeline', 'out', 'latex')
LOG_DIR   = os.path.join(SITE, '_stem_pipeline', 'logs')
PROGRESS  = os.path.join(LOG_DIR, 'shard-04-progress.jsonl')
for d in (OUT_STEMS, OUT_LATEX, LOG_DIR):
    os.makedirs(d, exist_ok=True)

def esc_tex(s):
    # escape minimal LaTeX specials for plain-text segments
    s = s.replace('\\\\', r'\\textbackslash{}')
    return s

def block_to_tex(b, depth=0):
    t = b.get('type')
    if t == 'paragraph':
        return b['text'] + '\\n\\n'
    if t == 'formula':
        return '\\\\[\\n' + b['latex'] + '\\n\\\\]\\n\\n'
    if t == 'chem':
        disp = b.get('display', True)
        inner = b['latex']
        if disp:
            return '\\\\[\\n\\\\ce{' + inner + '}\\n\\\\]\\n\\n'
        return '"'$'"\\\\ce{' + inner + '}"'$ '"'
    if t == 'heading':
        lvl = b.get('level', 3)
        cmd = '\\\\subsubsection*{' if lvl <= 3 else '\\\\paragraph*{'
        return cmd + b['text'] + '}\\n\\n'
    if t == 'list':
        env = 'enumerate' if b.get('ordered') else 'itemize'
        items = '\\n'.join('  \\\\item ' + it for it in b['items'])
        return '\\\\begin{' + env + '}\\n' + items + '\\n\\\\end{' + env + '}\\n\\n'
    if t == 'subpart':
        out = '\\\\textbf{' + b.get('label','') + '} ' + (b.get('prompt','') or '') + '\\n\\n'
        for blk in b.get('blocks', []):
            out += block_to_tex(blk, depth+1)
        return out
    if t == 'figure':
        cap = b.get('caption') or b.get('alt') or ''
        return '\\\\begin{figure}[h]\\n\\\\centering\\n\\\\fbox{\\\\parbox{0.7\\\\textwidth}{\\\\centering ' + (b.get('alt','') or '') + '}}\\n\\\\caption{' + cap + '}\\n\\\\end{figure}\\n\\n'
    if t == 'table':
        hdr = b.get('headers', [])
        rows = b.get('rows', [])
        cols = len(hdr) if hdr else (len(rows[0]) if rows else 1)
        colspec = '|' + '|'.join(['c']*cols) + '|'
        out = '\\\\begin{table}[h]\\n\\\\centering\\n'
        if b.get('caption'):
            out += '\\\\caption{' + b['caption'] + '}\\n'
        out += '\\\\begin{tabular}{' + colspec + '}\\n\\\\hline\\n'
        if hdr:
            out += ' & '.join(hdr) + ' \\\\\\\\\\n\\\\hline\\n'
        for r in rows:
            out += ' & '.join(str(c) for c in r) + ' \\\\\\\\\\n\\\\hline\\n'
        out += '\\\\end{tabular}\\n\\\\end{table}\\n\\n'
        return out
    if t == 'callout':
        return '\\\\emph{[' + b.get('tone','info') + '] ' + b['text'] + '}\\n\\n'
    return ''

def blocks_to_tex(blocks):
    return ''.join(block_to_tex(b) for b in blocks)

def build_latex(pid, title, number, year, stage, blocks, parts):
    head = ('\\\\section*{' + title.replace('\\\\','') + '}\\n'
            '（' + str(year) + '年' + ('决赛' if stage=='final' else '初赛') + ' 第' + str(number) + '题）\\n\\n')
    body = blocks_to_tex(blocks)
    for p in parts:
        body += '\\\\subsection*{' + p['label'] + '}\\n\\n'
        body += blocks_to_tex(p['blocks'])
    return head + body

def emit(pid, title, number, year, stage, source_label, source_doc, blocks, parts, page=0):
    stem = {
        \"schemaVersion\": 1,
        \"problemId\": pid,
        \"rightsState\": \"stem_public\",
        \"language\": \"zh-CN\",
        \"title\": title,
        \"number\": number,
        \"examYear\": year,
        \"examStage\": stage,
        \"source\": {
            \"sourceDocumentId\": source_doc,
            \"sourceLabel\": source_label,
            \"page\": page,
            \"transcriptionMethod\": \"ocr_reviewed\",
            \"transcribedAt\": \"2026-08-08\"
        },
        \"provenanceNote\": \"由 MinerU MD 结构化转写；公式已整理为 LaTeX/mhchem。\",
        \"renderingHints\": {\"mhchem\": True},
        \"blocks\": blocks,
        \"parts\": parts
    }
    # sanity: schema requires blocks or parts non-empty
    assert blocks or parts, pid
    with open(os.path.join(OUT_STEMS, pid + '.json'), 'w', encoding='utf-8') as f:
        json.dump(stem, f, ensure_ascii=False, indent=2)
    tex = build_latex(pid, title, number, year, stage, blocks, parts)
    with open(os.path.join(OUT_LATEX, pid + '.tex'), 'w', encoding='utf-8') as f:
        f.write(tex)
    with open(PROGRESS, 'a', encoding='utf-8') as f:
        f.write(json.dumps({\"problemId\": pid, \"ok\": True}, ensure_ascii=False) + '\\n')
    print('OK', pid, flush=True)
