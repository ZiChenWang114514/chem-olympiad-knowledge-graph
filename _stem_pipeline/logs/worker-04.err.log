# -*- coding: utf-8 -*-
import json, os, re, sys, datetime

SITE = r'D:\\ccho-site-public'
OUT_STEMS = os.path.join(SITE, '_stem_pipeline', 'out', 'stems')
OUT_LATEX = os.path.join(SITE, '_stem_pipeline', 'out', 'latex')
LOG_DIR   = os.path.join(SITE, '_stem_pipeline', 'logs')
PROGRESS  = os.path.join(LOG_DIR, 'shard-04-progress.jsonl')
UNMATCHED = os.path.join(LOG_DIR, 'shard-04-unmatched.md')
DONE      = os.path.join(LOG_DIR, 'shard-04-DONE.txt')

for d in (OUT_STEMS, OUT_LATEX, LOG_DIR):
    os.makedirs(d, exist_ok=True)

def clean_math(s):
    # collapse OCR spacing artifacts inside math like { 2 } -> {2}, \\mathrm { X } -> \\mathrm{X}
    s = re.sub(r'\\{(\\s+)(["'^{}]*?)('"\\s+)\\}', r'{\\2}', s)
    s = re.sub(r'\\\\mathrm\\s*\\{', r'\\\\mathrm{', s)
    s = re.sub(r'\\\\mathbf\\s*\\{', r'\\\\mathbf{', s)
    s = re.sub(r'\\\\mathsf\\s*\\{', r'\\\\mathsf{', s)
    s = re.sub(r'\\\\displaystyle\\s*', '', s)
    s = re.sub(r'\\\\enspace', '\\\\,', s)
    s = re.sub(r'\\\\quad\\s+', '\\\\quad ', s)
    s = s.replace('\\\\enspace ', '\\\\, ')
    s = s.replace('{ \\mathrm', '{\\\\mathrm')
    s = s.replace('\\\\mathrm {', '\\\\mathrm{')
    return s

def mk_stem(pid, title, number, year, stage, source_label, source_doc, blocks=None, parts=None,
            provenance='由 MinerU MD 结构化转写；公式已整理为 LaTeX/mhchem。', page=0, extra=None):
    stem = {
        \"schemaVersion\": 1,
        \"problemId\": pid,
        \"rightsState\": \"stem_public\",
        \"language\": \"zh-CN\",
        \"title\": title,
        \"number\": number,
        \"examYear\": year,
        \"examStage\": stage,
        \"source\": {
            \"sourceDocumentId\": source_doc,
            \"sourceLabel\": source_label,
            \"page\": page,
            \"transcriptionMethod\": \"ocr_reviewed\",
            \"transcribedAt\": \"2026-08-08\"
        },
        \"provenanceNote\": provenance,
        \"renderingHints\": {\"mhchem\": True},
        \"blocks\": blocks or [],
        \"parts\": parts or []
    }
    if extra:
        stem.update(extra)
    return stem

def write_stem(stem, latex_body):
    pid = stem['problemId']
    # validate schema basics
    assert stem['schemaVersion'] == 1
    assert pid == os.path.basename(pid)
    with open(os.path.join(OUT_STEMS, pid + '.json'), 'w', encoding='utf-8') as f:
        json.dump(stem, f, ensure_ascii=False, indent=2)
    with open(os.path.join(OUT_LATEX, pid + '.tex'), 'w', encoding='utf-8') as f:
        f.write(latex_body)
    with open(PROGRESS, 'a', encoding='utf-8') as f:
        f.write(json.dumps({\"problemId\": pid, \"ok\": True}, ensure_ascii=False) + '\\n')
    print('OK', pid)
