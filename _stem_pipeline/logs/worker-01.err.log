# -*- coding: utf-8 -*-
\"\"\"shard-01 common writer: ProblemStem JSON + LaTeX + progress\"\"\"
import json, os, re

BASE = r\"D:\\ccho-site-public\\_stem_pipeline\"
STEMS = os.path.join(BASE, \"out\", \"stems\")
LATEX = os.path.join(BASE, \"out\", \"latex\")
PROGRESS = os.path.join(BASE, \"logs\", \"shard-01-progress.jsonl\")

TRANS = {\"%\": r\"\\%\", \"&\": r\"\\&\", \"#\": r\"\\#\", \"_\": r\"\\_\"}

def esc_text(s):
    \"\"\"escape latex specials outside inline math "'$...$"""
    out, buf, in_math = [], [], False
    for ch in s:
        if ch == "$":
            in_math = not in_math
            buf.append(ch)
            continue
        if in_math:
            buf.append(ch)
        else:
            buf.append(TRANS.get(ch, ch))
    return "".join(buf)

def render_blocks(blocks, indent="  "):
    lines = []
    for b in blocks:
        t = b["type"]
        if t == "paragraph":
            lines.append(indent + esc_text(b["text"]))
        elif t == "formula":
            if b.get("display", True):
                lines.append(indent + "$$" + b["latex"] + "$$")
            else:
                lines.append(indent + "$" + b["latex"] + "$")
        elif t == "chem":
            lines.append(indent + "'"\\\\ce{\" + b[\"latex\"] + \"}\")
        elif t == \"heading\":
            lines.append(indent + \"\\\\paragraph{\" + esc_text(b[\"text\"]) + \"}\")
        elif t == \"list\":
            env = \"enumerate\" if b.get(\"ordered\", True) else \"itemize\"
            lines.append(indent + \"\\\\begin{\" + env + \"}\")
            for it in b[\"items\"]:
                lines.append(indent + \"  \\\\item \" + esc_text(it))
            lines.append(indent + \"\\\\end{\" + env + \"}\")
        elif t == \"subpart\":
            lines.append(indent + \"\\\\textbf{\" + esc_text(b[\"label\"]) + \"} \" + esc_text(b.get(\"prompt\", \"\")))
            lines.extend(render_blocks(b.get(\"blocks\", []), indent + \"  \"))
        elif t == \"figure\":
            cap = b.get(\"caption\") or b.get(\"alt\", \"\")
            lines.append(indent + \"\\\\textbf{[配图：%s]}\" % esc_text(cap))
        elif t == \"table\":
            lines.append(indent + \"\\\\begin{center}\\\\begin{tabular}{%s}\" % (\"c\" * len(b[\"headers\"])))
            lines.append(indent + \"  \" + \" & \".join(esc_text(h) for h in b[\"headers\"]) + r\" \\\\\")
            for row in b[\"rows\"]:
                lines.append(indent + \"  \" + \" & \".join(esc_text(c) for c in row) + r\" \\\\\")
            lines.append(indent + \"\\\\end{tabular}\\\\end{center}\")
        elif t == \"callout\":
            lines.append(indent + \"\\\\emph{[\" + b.get(\"tone\", \"info\") + \"] \" + esc_text(b[\"text\"]) + \"}\")
    return lines

def render_latex(problem, headline):
    lines = []
    lines.append(\"\\\\section*{\" + esc_text(headline) + \"}\")
    lines.append(\"\")
    for blk in problem.get(\"blocks\", []):
        lines.extend(render_blocks([blk]))
    if problem.get(\"parts\"):
        for p in problem[\"parts\"]:
            lines.append(\"\")
            lines.append(\"\\\\subsection*{\" + esc_text(p[\"label\"]) + \"}\")
            lines.extend(render_blocks(p[\"blocks\"]))
    return \"\\n\".join(lines) + \"\\n\"

def write_problem(problem, headline):
    pid = problem[\"problemId\"]
    with open(os.path.join(STEMS, pid + \".json\"), \"w\", encoding=\"utf-8\") as f:
        json.dump(problem, f, ensure_ascii=False, indent=2)
    latex = render_latex(problem, headline)
    with open(os.path.join(LATEX, pid + \".tex\"), \"w\", encoding=\"utf-8\") as f:
        f.write(latex)
    with open(PROGRESS, \"a\", encoding=\"utf-8\") as f:
        f.write(json.dumps({\"problemId\": pid, \"ok\": True}, ensure_ascii=False) + \"\\n\")
    print(\"wrote \" + pid)

def make_problem(pid, number, title, examYear, examStage, sourceLabel, sourceDocumentId,
                 blocks, parts, headline):
    return {
        \"schemaVersion\": 1,
        \"problemId\": pid,
        \"rightsState\": \"stem_public\",
        \"language\": \"zh-CN\",
        \"title\": title,
        \"number\": number,
        \"examYear\": examYear,
        \"examStage\": examStage,
        \"source\": {
            \"sourceDocumentId\": sourceDocumentId,
            \"sourceLabel\": sourceLabel,
            \"page\": 0,
            \"transcriptionMethod\": \"ocr_reviewed\",
            \"transcribedAt\": \"2026-08-08\"
        },
        \"provenanceNote\": \"由 MinerU MD 结构化转写；公式已整理为 LaTeX/mhchem。\",
        \"renderingHints\": {\"mhchem\": True},
        \"blocks\": blocks,
        \"parts\": parts
    }

def P(label, text):
    return {\"type\": \"paragraph\", \"text\": text}

def F(latex, display=True):
    return {\"type\": \"formula\", \"latex\": latex, \"display\": display}

def C(latex, display=False):
    return {\"type\": \"chem\", \"latex\": latex, \"display\": display}

def FIG(alt, caption=None):
    d = {\"type\": \"figure\", \"alt\": alt}
    if caption:
        d[\"caption\"] = caption
    return d

def CAL(text, tone=\"info\"):
    return {\"type\": \"callout\", \"tone\": tone, \"text\": text}

def SUB(label, prompt, blocks):
    return {\"type\": \"subpart\", \"label\": label, \"prompt\": prompt, \"blocks\": blocks}
