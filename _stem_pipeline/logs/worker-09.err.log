# -*- coding: utf-8 -*-
\"\"\"Shared helpers for shard-09 stem generation.\"\"\"
import json, os

STEM_DIR = r\"D:\\ccho-site-public\\_stem_pipeline\\out\\stems\"
LATEX_DIR = r\"D:\\ccho-site-public\\_stem_pipeline\\out\\latex\"

def p(text):
    return {\"type\": \"paragraph\", \"text\": text}

def f(latex, display=True):
    return {\"type\": \"formula\", \"latex\": latex, \"display\": display}

def c(latex, display=True):
    return {\"type\": \"chem\", \"latex\": latex, \"display\": display}

def h(text, level=3):
    return {\"type\": \"heading\", \"level\": level, \"text\": text}

def fig(alt, caption=None):
    d = {\"type\": \"figure\", \"alt\": alt}
    if caption:
        d[\"caption\"] = caption
    return d

def call(text, tone=\"info\"):
    return {\"type\": \"callout\", \"tone\": tone, \"text\": text}

def tbl(headers, rows, caption=None):
    d = {\"type\": \"table\", \"headers\": headers, \"rows\": rows}
    if caption:
        d[\"caption\"] = caption
    return d

def make_stem(pid, title, number, year, stage, source_label, source_doc, blocks, parts, extra=None):
    stem = {
        \"schemaVersion\": 1,
        \"problemId\": pid,
        \"rightsState\": \"stem_public\",
        \"language\": \"zh-CN\",
        \"title\": title,
        \"number\": number,
        \"examYear\": year,
        \"examStage\": stage,
        \"source\": {
            \"sourceDocumentId\": source_doc,
            \"sourceLabel\": source_label,
            \"page\": 0,
            \"transcriptionMethod\": \"ocr_reviewed\",
            \"transcribedAt\": \"2026-08-08\"
        },
        \"provenanceNote\": \"由 MinerU MD 结构化转写；公式已整理为 LaTeX/mhchem。\",
        \"renderingHints\": {\"mhchem\": True},
        \"blocks\": blocks,
        \"parts\": parts
    }
    if extra:
        stem.update(extra)
    return stem

def part(label, blocks):
    return {\"id\": \"part-\" + label.replace(\"-\", \"_\").replace(\"(\", \"\").replace(\")\", \"\").lower(), \"label\": label, \"blocks\": blocks}

def write_all(stems):
    for stem in stems:
        pid = stem[\"problemId\"]
        with open(os.path.join(STEM_DIR, pid + \".json\"), \"w\", encoding=\"utf-8\") as fh:
            json.dump(stem, fh, ensure_ascii=False, indent=2)
        # latex
        tex = stem.pop(\"_tex\", None)
        if tex is not None:
            with open(os.path.join(LATEX_DIR, pid + \".tex\"), \"w\", encoding=\"utf-8\") as fh:
                fh.write(tex)
        with open(os.path.join(STEM_DIR, pid + \".json\"), \"w\", encoding=\"utf-8\") as fh:
            json.dump(stem, fh, ensure_ascii=False, indent=2)
    print(\"wrote\", len(stems), \"stems\")
