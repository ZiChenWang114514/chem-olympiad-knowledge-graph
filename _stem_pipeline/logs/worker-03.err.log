# -*- coding: utf-8 -*-
import json, os, io, sys

BASE = r\"D:\\ccho-site-public\"
STEMS = os.path.join(BASE, \"_stem_pipeline\", \"out\", \"stems\")
LATEX = os.path.join(BASE, \"_stem_pipeline\", \"out\", \"latex\")
LOG = os.path.join(BASE, \"_stem_pipeline\", \"logs\", \"shard-03-progress.jsonl\")

PART_CTR = [0]

def part_id():
    PART_CTR[0] += 1
    return \"part-%06d\" % PART_CTR[0]

def latex_from_blocks(blocks, out):
    for b in blocks:
        t = b.get(\"type\")
        if t == \"paragraph\":
            out.append(b[\"text\"])
            out.append(\"\")
        elif t == \"formula\":
            out.append(\"\\\\[\\n\" + b[\"latex\"] + \"\\n\\\\]\")
            out.append(\"\")
        elif t == \"chem\":
            out.append(\"\\\\[\\n\\\\ce{\" + b[\"latex\"] + \"}\\n\\\\]\")
            out.append(\"\")
        elif t == \"heading\":
            out.append(\"\\\\subsection*{\" + b[\"text\"] + \"}\")
            out.append(\"\")
        elif t == \"list\":
            env = \"enumerate\" if b.get(\"ordered\") else \"itemize\"
            out.append(\"\\\\begin{\" + env + \"}\")
            for it in b[\"items\"]:
                out.append(\"  \\\\item \" + it)
            out.append(\"\\\\end{\" + env + \"}\")
            out.append(\"\")
        elif t == \"figure\":
            cap = b.get(\"caption\") or b.get(\"alt\") or \"插图\"
            out.append(\"\\\\textit{插图：\" + cap + \"}\")
            out.append(\"\")
        elif t == \"table\":
            out.append(\"\\\\begin{center}\\\\begin{tabular}{\" + (\"l\" * len(b.get(\"headers\", []))) + \"}\")
            out.append(\" & \".join(b.get(\"headers\", [])) + \" \\\\\\\\ \\\\hline\")
            for r in b.get(\"rows\", []):
                out.append(\" & \".join(r) + \" \\\\\\\\\")
            out.append(\"\\\\end{tabular}\\\\end{center}\")
            out.append(\"\")
        elif t == \"callout\":
            out.append(\"\\\\textit{注：\" + b.get(\"text\", \"\") + \"}\")
            out.append(\"\")
        elif t == \"subpart\":
            out.append(\"\\\\textbf{\" + b.get(\"label\", \"\") + \"} \" + (b.get(\"prompt\", \"\") or \"\"))
            latex_from_blocks(b.get(\"blocks\", []), out)

def build_tex(stem):
    lines = []
    lines.append(\"\\\\section*{第%s题　%s}\" % (stem[\"number\"], stem[\"title\"]))
    lines.append(\"\")
    if stem.get(\"blocks\"):
        latex_from_blocks(stem[\"blocks\"], lines)
    for p in stem.get(\"parts\", []):
        lines.append(\"\\\\textbf{%s}\" % p[\"label\"])
        lines.append(\"\")
        latex_from_blocks(p[\"blocks\"], lines)
    return \"\\n\".join(lines)

def save(meta, blocks, parts, title_override=None, number_override=None):
    pid = meta[\"problemId\"]
    stem = {
        \"schemaVersion\": 1,
        \"problemId\": pid,
        \"rightsState\": \"stem_public\",
        \"language\": \"zh-CN\",
        \"title\": title_override or meta[\"title\"],
        \"number\": number_override or meta[\"number\"],
        \"examYear\": meta[\"year\"],
        \"examStage\": meta[\"stage\"],
        \"source\": {
            \"sourceLabel\": meta[\"sourceLabel\"],
            \"page\": 0,
            \"transcriptionMethod\": \"ocr_reviewed\",
            \"transcribedAt\": \"2026-08-08\"
        },
        \"provenanceNote\": \"由 MinerU MD 结构化转写；公式已整理为 LaTeX/mhchem。\",
        \"renderingHints\": {\"mhchem\": True},
    }
    if meta.get(\"sourceDocumentId\"):
        stem[\"source\"][\"sourceDocumentId\"] = meta[\"sourceDocumentId\"]
    if blocks:
        stem[\"blocks\"] = blocks
    if parts:
        ps = []
        for lab, pblocks in parts:
            ps.append({\"id\": part_id(), \"label\": lab, \"blocks\": pblocks})
        stem[\"parts\"] = ps
    assert stem.get(\"blocks\") or stem.get(\"parts\"), pid
    with io.open(os.path.join(STEMS, pid + \".json\"), \"w\", encoding=\"utf-8\") as f:
        json.dump(stem, f, ensure_ascii=False, indent=2)
    with io.open(os.path.join(LATEX, pid + \".tex\"), \"w\", encoding=\"utf-8\") as f:
        f.write(build_tex(stem))
    with io.open(LOG, \"a\", encoding=\"utf-8\") as f:
        f.write(json.dumps({\"problemId\": pid, \"ok\": True}, ensure_ascii=False) + \"\\n\")
    print(\"OK\", pid, stem[\"title\"])
