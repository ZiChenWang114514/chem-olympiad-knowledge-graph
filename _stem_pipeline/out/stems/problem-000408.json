  "blocks": [],
  "parts": [
    {
      "id": "part-000408-01",
      "label": "1-1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "加热时,三氧化二锰与一氧化碳反应产生四氧化三锰。"
        }
      ]
    },
    {
      "id": "part-000408-02",
      "label": "1-2",
      "blocks": [
        {
          "type": "paragraph",
          "text": "将 $\\ce{KCN}$ 加入到过量的 $\\ce{CuSO4}$ 水溶液中。"
        }
      ]
    },
    {
      "id": "part-000408-03",
      "label": "1-3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "在碱性溶液中,$\\ce{Cr2O3}$ 和 $\\ce{K3Fe(CN)6}$ 反应。"
        }
      ]
    },
    {
      "id": "part-000408-04",
      "label": "1-4",
      "blocks": [
        {
          "type": "paragraph",
          "text": "在碱性条件下,$\\ce{[Zn(CN)4]^{2-}}$ 和甲醛反应。"
        }
      ]
    },
    {
      "id": "part-000408-05",
      "label": "1-5",
      "blocks": [
        {
          "type": "paragraph",
          "text": "$\\ce{Fe(OH)2}$ 在常温无氧条件下转化为 $\\ce{Fe3O4}$。"
        }
      ]
    },
    {
      "id": "part-000408-06",
      "label": "1-6",
      "blocks": [
        {
          "type": "paragraph",
          "text": "将 $\\ce{NaNO3}$ 粉末小心加到熔融的 $\\ce{NaNH2}$ 中,生成 $\\ce{NaN3}$(没有水生成)。"
        }
      ]
    }
  ]
}
