      "label": "8-1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "画出以下反应过程中化合物A-F的结构简式."
        },
        {
          "type": "figure",
          "src": "data/stems/assets/problem-000019-figure-001.jpg",
          "alt": "原卷第8题图1：画出以下反应过程中化合物A-F的结构简式.",
