      "displayWidth": 100
    },
    {
      "type": "figure",
      "src": "data/stems/assets/problem-000243-figure-002.jpg",
      "assetId": "asset-003266",
      "alt": "分光光度法测平衡常数：第2幅原卷结构或数据示意",
