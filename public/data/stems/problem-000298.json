          "assetId": "asset-004894"
        }
      ],
      "partId": "part-000647"
    },
    {
      "type": "subpart",
      "label": "7-2-1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "写出 A 中药物性小分子羧酸的结构式并命名。"
        }
      ],
      "partId": "part-000648"
    },
    {
      "type": "subpart",
      "label": "7-2-2",
      "blocks": [
        {
          "type": "paragraph",
          "text": "写出 B 中氨基酸的结构式并命名。"
        }
      ],
      "partId": "part-000649"
    },
    {
      "type": "subpart",
      "label": "7-2-3",
      "blocks": [
        {
